<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal Maven settings for the Docker build.

  Repository URLs (US Maven Central, Google CDN, Aliyun) are declared directly
  in the root pom.xml so a single pom covers multiple regions. Maven tries each
  repository in order and falls over on 404 / unreachable.

  This file intentionally does not force a mirror. A mirrorOf=* entry would
  intercept every repository and remove that fallback behavior. Developers who
  need a corporate proxy or regional mirror can configure it outside the repo.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors/>
</settings>
