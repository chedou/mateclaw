<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings shared by Docker, CI, and local verification.

  All remote repository IDs are intentionally mirrored to Aliyun so developer
  machines do not inherit an unreachable corporate mirror from ~/.m2/settings.xml.
  Commands that require reproducible resolution must pass this file through
  Maven's explicit settings-file option.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>aliyun-public-mirror</id>
      <name>Aliyun Maven Public</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
