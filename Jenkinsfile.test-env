pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
    timeout(time: 90, unit: 'MINUTES')
    skipDefaultCheckout(true)
  }

  parameters {
    choice(
      name: 'ACTION',
      choices: ['VERIFY_ONLY', 'UPGRADE_LIBSECCOMP', 'DEPLOY'],
      description: 'VERIFY_ONLY 只构建并预检；UPGRADE_LIBSECCOMP 仅受控升级 Docker18 宿主 libseccomp；DEPLOY 才切换测试环境。'
    )
    string(
      name: 'BRANCH',
      defaultValue: 'intelligent-troubleshooting-design',
      description: '从内网 GitLab 检出的分支。'
    )
    string(
      name: 'EXPECTED_COMMIT',
      defaultValue: '',
      description: '期望执行的完整 40 位 Git SHA。主机维护和 DEPLOY 必填且不一致立即停止。'
    )
    string(
      name: 'MATECLAW_RUNTIME_BASE_IMAGE',
      defaultValue: 'itharbor.sangfor.com/ai-uat/mateclaw-playwright:v1.62.0-noble@sha256:0e5163ed3364179e474b849dbecfaa46a06e21212abe2c67873f706dc609b88e',
      description: '已同步到深信服 Harbor 的 Playwright v1.62.0-noble 完整 tag@sha256 引用。不是内网不可变引用时立即停止。'
    )
  }

  environment {
    ACTION = "${params.ACTION}"
    BRANCH = "${params.BRANCH}"
    EXPECTED_COMMIT = "${params.EXPECTED_COMMIT}"
    REPOSITORY_URL = 'http://itgitlab.sangfor.com/it-sre/mateclaw.git'
    RELEASES_DIR = '/opt/mateclaw/releases'
    DATA_DIR = '/opt/mateclaw/data'
    ENV_FILE = '/opt/mateclaw/mateclaw.env'
    CONTAINER = 'mateclaw-server'
    HEALTH_URL = 'http://127.0.0.1:18080/actuator/health'
    INFO_URL = 'http://127.0.0.1:18080/actuator/info'
    HARBOR_REGISTRY = 'itharbor.sangfor.com'
    DOCKER_CONFIG = "${WORKSPACE}/.docker-config-${BUILD_NUMBER}"
    MATECLAW_FRONTEND_BASE_IMAGE = 'itharbor.sangfor.com/base-image/node:22.18.0-alpine@sha256:ac0d137a585eaaaf648c4f011a6f52cbb71952f9471e76c343fdb2d1cd711b62'
    MATECLAW_BACKEND_BASE_IMAGE = 'itharbor.sangfor.com/ai-uat/mateclaw-maven:3.9.6-eclipse-temurin-21-alpine@sha256:1750ed0e15881d6b9e11d8657026a492cd29e85e009481bbb1d0d7a0056e42b9'
    APPROVED_RUNTIME_BASE_IMAGE = 'itharbor.sangfor.com/ai-uat/mateclaw-playwright:v1.62.0-noble@sha256:0e5163ed3364179e474b849dbecfaa46a06e21212abe2c67873f706dc609b88e'
    MATECLAW_RUNTIME_BASE_IMAGE = "${params.MATECLAW_RUNTIME_BASE_IMAGE}"
    LEGACY_RUNTIME_IMAGE_RECORD = '/opt/mateclaw/libseccomp-maintenance/activation-report.txt'
    APPROVED_FOUNDATION_FROM = '204'
    APPROVED_FOUNDATION_TO = '217'
    APPROVED_FOUNDATION_SHA256 = '910e0f45f34074414ed84b01d3c7eb059c6080148228278cad8f69e96aaef4c6'
    APPROVED_FORMAL_DIAGNOSIS_FROM = '217'
    APPROVED_FORMAL_DIAGNOSIS_TO = '223'
    APPROVED_FORMAL_DIAGNOSIS_SHA256 = 'c700c79e21b35391582403cc878dd88aaf8d42dc7d5b2fef2870a064c2aead3f'
    APPROVED_ITDB_FROM = '223'
    APPROVED_ITDB_TO = '225'
    APPROVED_ITDB_SHA256 = '04be0b2cf0d4aa2925e8df22bf3a27e279ad9562f63ecab68d59cd8b0470d5f0'
    APPROVED_RUNTIME_FROM = '225'
    APPROVED_RUNTIME_TO = '228'
    APPROVED_RUNTIME_SHA256 = 'a76d0ea290558393f30adeea107f5f8b0230ba15e478b4fab28215edde0b82c6'
    CANDIDATE_IMAGE = "mateclaw-troubleshooting:jenkins-candidate-${BUILD_NUMBER}"
  }

  stages {
    stage('检出精确版本') {
      steps {
        script {
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.ACTION}"
          currentBuild.description = "${params.BRANCH} ${params.EXPECTED_COMMIT ?: 'branch-head'}"
          if (!(params.BRANCH ==~ /^[A-Za-z0-9][A-Za-z0-9._\/-]{0,199}$/) || params.BRANCH.contains('..') || params.BRANCH.contains('//') || params.BRANCH.contains('@{') || params.BRANCH.endsWith('/') || params.BRANCH.endsWith('.lock')) {
            error('BRANCH 格式不合法或包含不安全片段')
          }
          if (params.ACTION in ['DEPLOY', 'UPGRADE_LIBSECCOMP'] && !(params.EXPECTED_COMMIT ==~ /^[0-9a-fA-F]{40}$/)) {
            error('主机维护和 DEPLOY 必须提供完整 40 位 EXPECTED_COMMIT')
          }
          if (params.ACTION != 'UPGRADE_LIBSECCOMP' && params.MATECLAW_RUNTIME_BASE_IMAGE != env.APPROVED_RUNTIME_BASE_IMAGE) {
            error('MATECLAW_RUNTIME_BASE_IMAGE 必须等于代码中已审核的 Playwright 不可变引用')
          }
          dir('source') {
            deleteDir()
            checkout([
              $class: 'GitSCM',
              branches: [[name: "refs/heads/${params.BRANCH}"]],
              extensions: [[$class: 'CloneOption', depth: 1, noTags: true, shallow: true, timeout: 20]],
              userRemoteConfigs: [[credentialsId: 'mateclaw-itgitlab-readonly', url: env.REPOSITORY_URL]]
            ])
          }
        }
        script {
          if (params.ACTION != 'UPGRADE_LIBSECCOMP') {
            timeout(time: 2, unit: 'MINUTES') {
              withCredentials([usernamePassword(
                credentialsId: 'itharbor',
                usernameVariable: 'HARBOR_USERNAME',
                passwordVariable: 'HARBOR_PASSWORD'
              )]) {
                sh '''#!/usr/bin/env bash
set +x
set -euo pipefail
umask 077

fail() {
  echo "HARBOR_LOGIN_FAILED: $*" >&2
  exit 1
}

expected_docker_config="$WORKSPACE/.docker-config-${BUILD_NUMBER}"
[[ "$DOCKER_CONFIG" == "$expected_docker_config" ]] \
  || fail "DOCKER_CONFIG 越出当前 Jenkins Workspace"
[[ ! -L "$DOCKER_CONFIG" ]] \
  || fail "临时 DOCKER_CONFIG 不允许是符号链接"
if [[ -e "$DOCKER_CONFIG" && ! -d "$DOCKER_CONFIG" ]]; then
  fail "临时 DOCKER_CONFIG 路径不是目录"
fi
mkdir -p -- "$DOCKER_CONFIG"
find "$DOCKER_CONFIG" -mindepth 1 -delete
chmod 700 "$DOCKER_CONFIG"

command -v docker >/dev/null || fail "docker 命令不存在"
printf '%s\n' "$HARBOR_PASSWORD" \
  | docker login --username "$HARBOR_USERNAME" --password-stdin "$HARBOR_REGISTRY" \
      >/dev/null \
  || fail "无法使用 Jenkins credentialId itharbor 登录深信服 Harbor"
unset HARBOR_PASSWORD

[[ -f "$DOCKER_CONFIG/config.json" && ! -L "$DOCKER_CONFIG/config.json" ]] \
  || fail "Docker 未生成可用的临时认证文件"
chmod 600 "$DOCKER_CONFIG/config.json"
echo 'HARBOR_LOGIN_OK'
'''
              }
            }
          } else {
            echo 'HARBOR_LOGIN_SKIPPED: UPGRADE_LIBSECCOMP 仅执行宿主维护'
          }
        }
        sh '''#!/usr/bin/env bash
set +x
set -euo pipefail
umask 077

# Declarative Pipeline parameters are materialized as job properties after the
# first run. Replays can temporarily clear those properties, so keep the first
# VERIFY_ONLY run deterministic without weakening DEPLOY's SHA requirement.
ACTION="${ACTION:-VERIFY_ONLY}"
BRANCH="${BRANCH:-intelligent-troubleshooting-design}"
EXPECTED_COMMIT="${EXPECTED_COMMIT:-}"

fail() {
  echo "SOURCE_PRECHECK_FAILED: $*" >&2
  exit 1
}

command -v git >/dev/null || fail "git 命令不存在"
command -v docker >/dev/null || fail "docker 命令不存在"
command -v curl >/dev/null || fail "curl 命令不存在"
command -v sha256sum >/dev/null || fail "sha256sum 命令不存在"
command -v find >/dev/null || fail "find 命令不存在"
command -v sort >/dev/null || fail "sort 命令不存在"
command -v sed >/dev/null || fail "sed 命令不存在"
command -v tr >/dev/null || fail "tr 命令不存在"
test -S /var/run/docker.sock || fail "Jenkins 无法访问 Docker socket"
docker info >/dev/null 2>&1 || fail "Jenkins 无法访问 Docker daemon"
docker_server_version="$(docker version --format '{{.Server.Version}}')"
docker_security_options="$(docker info --format '{{range .SecurityOptions}}{{println .}}{{end}}')"

[[ "$BRANCH" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$ ]] \
  || fail "BRANCH 格式不合法"
case "$BRANCH" in
  *..*|*//*|*@{*|*/|*.lock) fail "BRANCH 包含不安全片段" ;;
esac

if [[ -n "$EXPECTED_COMMIT" ]]; then
  [[ "$EXPECTED_COMMIT" =~ ^[0-9a-fA-F]{40}$ ]] \
    || fail "EXPECTED_COMMIT 必须是完整 40 位 Git SHA"
elif [[ "$ACTION" == "DEPLOY" || "$ACTION" == "UPGRADE_LIBSECCOMP" ]]; then
  fail "主机维护和 DEPLOY 必须提供 EXPECTED_COMMIT，禁止按漂移的分支头执行"
fi

SOURCE_DIR="$WORKSPACE/source"
case "$SOURCE_DIR" in
  "$WORKSPACE"/source) ;;
  *) fail "源码目录越出 Jenkins Workspace" ;;
esac
test -d "$SOURCE_DIR/.git" || fail "内网 GitLab 检出目录缺少 .git"
resolved_commit="$(git --git-dir="$SOURCE_DIR/.git" --work-tree="$SOURCE_DIR" rev-parse HEAD | tr '[:upper:]' '[:lower:]')"
[[ "$resolved_commit" =~ ^[0-9a-f]{40}$ ]] || fail "无法解析检出提交"

if [[ -n "$EXPECTED_COMMIT" ]]; then
  expected_commit="$(printf '%s' "$EXPECTED_COMMIT" | tr '[:upper:]' '[:lower:]')"
  [[ "$resolved_commit" == "$expected_commit" ]] \
    || fail "检出提交 $resolved_commit 与期望提交 $expected_commit 不一致"
fi

test -f "$SOURCE_DIR/mateclaw-server/Dockerfile" \
  || fail "内网 GitLab 检出缺少后端 Dockerfile"
test -f "$SOURCE_DIR/pom.xml" || fail "内网 GitLab 检出缺少根 pom.xml"
test -x "$SOURCE_DIR/scripts/ci/test-runtime-apt-hardening.sh" \
  || fail "缺少可执行的运行镜像 APT 回归检查"
"$SOURCE_DIR/scripts/ci/test-runtime-apt-hardening.sh" \
  || fail "运行镜像 APT 回归检查失败"
test -x "$SOURCE_DIR/scripts/ci/test-docker-clone3-compatibility.sh" \
  || fail "缺少可执行的 Docker clone3 门禁回归检查"
"$SOURCE_DIR/scripts/ci/test-docker-clone3-compatibility.sh" \
  || fail "Docker clone3 门禁回归检查失败"
test -x "$SOURCE_DIR/scripts/ci/test-test-env-candidate-image-build.sh" \
  || fail "缺少可执行的 Docker 18 候选镜像组装回归检查"
"$SOURCE_DIR/scripts/ci/test-test-env-candidate-image-build.sh" \
  || fail "Docker 18 候选镜像组装回归检查失败"
test -x "$SOURCE_DIR/scripts/ci/test-detect-libseccomp-version.sh" \
  || fail "缺少可执行的 libseccomp 实际版本检测回归检查"
"$SOURCE_DIR/scripts/ci/test-detect-libseccomp-version.sh" \
  || fail "libseccomp 实际版本检测回归检查失败"
test -x "$SOURCE_DIR/scripts/ci/test-libseccomp-maintenance-pipeline.sh" \
  || fail "缺少可执行的 libseccomp 维护流水线回归检查"
"$SOURCE_DIR/scripts/ci/test-libseccomp-maintenance-pipeline.sh" \
  || fail "libseccomp 维护流水线回归检查失败"
test -x "$SOURCE_DIR/scripts/ops/test-upgrade-libseccomp-docker18.sh" \
  || fail "缺少可执行的 libseccomp 原子切换与回滚检查"
"$SOURCE_DIR/scripts/ops/test-upgrade-libseccomp-docker18.sh" \
  || fail "libseccomp 原子切换与回滚检查失败"
test -x "$SOURCE_DIR/scripts/ci/test-test-env-migration-policy.sh" \
  || fail "缺少可执行的测试环境迁移门禁回归检查"
"$SOURCE_DIR/scripts/ci/test-test-env-migration-policy.sh" \
  || fail "测试环境迁移门禁回归检查失败"
test -x "$SOURCE_DIR/scripts/ci/test-test-env-optional-itdb.sh" \
  || fail "缺少可执行的可选 ITDB 接入回归检查"
"$SOURCE_DIR/scripts/ci/test-test-env-optional-itdb.sh" \
  || fail "可选 ITDB 接入回归检查失败"

printf '%s\n' "$resolved_commit" > resolved-commit.txt
if [[ "$ACTION" == "UPGRADE_LIBSECCOMP" ]]; then
  test -x "$SOURCE_DIR/scripts/ci/detect-libseccomp-version.sh" \
    || fail "缺少可执行的 libseccomp 实际版本检测器"
  test -x "$SOURCE_DIR/scripts/ops/upgrade-libseccomp-docker18.sh" \
    || fail "缺少可执行的 libseccomp 受控维护脚本"
  {
    echo "checked_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "action=$ACTION"
    echo "branch=$BRANCH"
    echo "resolved_commit=$resolved_commit"
    echo "docker_server=$docker_server_version"
    echo "host_maintenance=READY"
    echo "source_build=INTERNAL_GITLAB_EXACT_COMMIT_CHECKOUT"
  } > preflight-report.txt
  cat preflight-report.txt
  echo "SOURCE_PRECHECK_OK"
  exit 0
fi

test -x "$SOURCE_DIR/scripts/ci/check-docker-clone3-compatibility.sh" \
  || fail "缺少可执行的 Docker clone3 兼容性检查"
"$SOURCE_DIR/scripts/ci/check-docker-clone3-compatibility.sh" \
  "$docker_server_version" "$docker_security_options" \
  "$SOURCE_DIR/mateclaw-server/Dockerfile" \
  "$SOURCE_DIR/deploy/seccomp/docker18-clone3.json" \
  "$LEGACY_RUNTIME_IMAGE_RECORD" \
  > runtime-compatibility.txt \
  || fail "Docker 宿主不满足现代 glibc 的 seccomp 要求；禁止用 seccomp=unconfined 绕过"
cat runtime-compatibility.txt
docker_runtime_compatibility="$(
  sed -n 's/^docker_runtime_compatibility=//p' runtime-compatibility.txt | head -n 1
)"
legacy_runtime_probe="$(
  sed -n 's/^legacy_runtime_probe=//p' runtime-compatibility.txt | head -n 1
)"
legacy_libseccomp_version="$(
  sed -n 's/^legacy_libseccomp_version=//p' runtime-compatibility.txt | head -n 1
)"
case "$docker_runtime_compatibility:$legacy_runtime_probe" in
  NATIVE_CLONE3_SECCOMP:NOT_REQUIRED|LEGACY_CUSTOM_SECCOMP:PASSED) ;;
  *) fail "Docker 兼容性报告不完整或状态不一致" ;;
esac

printf 'mateclaw-troubleshooting:%s-mysql\n' "${resolved_commit:0:12}" > target-image.txt

current_state="ABSENT"
current_image="NONE"
current_health="NOT_CHECKED"
if docker inspect "$CONTAINER" >/dev/null 2>&1; then
  current_state="$(docker inspect --format '{{.State.Status}}' "$CONTAINER")"
  current_image="$(docker inspect --format '{{.Config.Image}}' "$CONTAINER")"
  if [[ "$current_state" == "running" ]]; then
    curl -fsS --max-time 5 "$HEALTH_URL" > current-health.json \
      || fail "当前 MateClaw 健康检查失败"
    current_health="UP"
  fi
fi

docker_security_options_report="$(
  printf '%s\n' "$docker_security_options" | tr '\n' ',' | sed 's/,$//'
)"

test -f "$ENV_FILE" || fail "缺少 $ENV_FILE"
env_mode="$(stat -c '%a' "$ENV_FILE")"
case "$env_mode" in
  400|600) ;;
  *) fail "mateclaw.env 权限必须为 0400 或 0600，当前为 $env_mode" ;;
esac
grep -Eq '^SPRING_PROFILES_ACTIVE=(mysql,csdp-guance-evidence-pilot|csdp-guance-evidence-pilot,mysql)$' "$ENV_FILE" \
  || fail "测试环境必须同时启用 MySQL 与通用观测云调查 profile"
grep -Eq '^DB_HOST=.+$' "$ENV_FILE" || fail "环境文件缺少 DB_HOST"
grep -Eq '^DB_USERNAME=.+$' "$ENV_FILE" || fail "环境文件缺少 DB_USERNAME"
grep -Eq '^DB_PASSWORD=.+$' "$ENV_FILE" || fail "环境文件缺少 DB_PASSWORD"
grep -Eq '^JWT_SECRET=.+$' "$ENV_FILE" || fail "环境文件缺少 JWT_SECRET"
flyway_auto_repair="$(sed -n 's/^MATECLAW_FLYWAY_AUTO_REPAIR=//p' "$ENV_FILE" | head -1)"
case "$flyway_auto_repair" in
  ''|false) ;;
  *) fail "测试环境禁止 MATECLAW_FLYWAY_AUTO_REPAIR；失败迁移必须保留证据并 fail-closed" ;;
esac
sha256sum "$ENV_FILE" | awk '{print $1}' > env-file-sha256.txt
itdb_enabled="$(sed -n 's/^MATECLAW_ITDB_ENABLED=//p' "$ENV_FILE" | head -1)"
itdb_enabled="${itdb_enabled:-false}"
itdb_integration="DISABLED"
if [[ "$itdb_enabled" == "true" ]]; then
  grep -Eq '^MATECLAW_ITDB_BASE_URL=https://[^[:space:]]+$' "$ENV_FILE" \
    || fail "已启用 ITDB，但环境文件缺少 HTTPS 的 MATECLAW_ITDB_BASE_URL"
  grep -Eq '^MATECLAW_ITDB_USERNAME=.+$' "$ENV_FILE" \
    || fail "已启用 ITDB，但环境文件缺少 MATECLAW_ITDB_USERNAME"
  grep -Eq '^MATECLAW_ITDB_PASSWORD=.+$' "$ENV_FILE" \
    || fail "已启用 ITDB，但环境文件缺少 MATECLAW_ITDB_PASSWORD"
  grep -Eq '^MATECLAW_ITDB_ALLOWED_HOSTS=.+$' "$ENV_FILE" \
    || fail "已启用 ITDB，但环境文件缺少 MATECLAW_ITDB_ALLOWED_HOSTS"

  itdb_base_url="$(sed -n 's/^MATECLAW_ITDB_BASE_URL=//p' "$ENV_FILE" | head -1)"
  itdb_username="$(sed -n 's/^MATECLAW_ITDB_USERNAME=//p' "$ENV_FILE" | head -1)"
  itdb_password="$(sed -n 's/^MATECLAW_ITDB_PASSWORD=//p' "$ENV_FILE" | head -1)"
  itdb_token_probe="$WORKSPACE/.itdb-token-probe-${BUILD_NUMBER}.json"
  cleanup_itdb_probe() { rm -f -- "$itdb_token_probe"; }
  trap cleanup_itdb_probe EXIT
  curl --fail --silent --show-error --max-time 15 --max-redirs 0 --proto '=https' \
    --data-urlencode "username=$itdb_username" \
    --data-urlencode "password=$itdb_password" \
    -o "$itdb_token_probe" \
    "$itdb_base_url/api/auth/token/" \
    || fail "ITDB JWT API 不可直连、发生重定向或账号不可用"
  grep -Eq '"access"[[:space:]]*:' "$itdb_token_probe" \
    || fail "ITDB JWT API 未返回 access token"
  cleanup_itdb_probe
  trap - EXIT
  itdb_integration="ENABLED_AND_AUTHENTICATED"
elif [[ "$itdb_enabled" != "false" ]]; then
  fail "MATECLAW_ITDB_ENABLED 只允许 true 或 false"
fi

{
  echo "checked_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "action=$ACTION"
  echo "branch=$BRANCH"
  echo "resolved_commit=$resolved_commit"
  echo "target_image=$(cat target-image.txt)"
  echo "docker_server=$docker_server_version"
  echo "docker_security_options=$docker_security_options_report"
  echo "docker_runtime_compatibility=$docker_runtime_compatibility"
  echo "legacy_runtime_probe=$legacy_runtime_probe"
  echo "legacy_libseccomp_version=${legacy_libseccomp_version:-NOT_REQUIRED}"
  echo "itdb_integration=$itdb_integration"
  echo "current_container_state=$current_state"
  echo "current_image=$current_image"
  echo "current_health=$current_health"
  echo "source_build=INTERNAL_GITLAB_EXACT_COMMIT_CHECKOUT"
} > preflight-report.txt

cat preflight-report.txt
echo "SOURCE_PRECHECK_OK"
'''
      }
    }

    stage('Docker18 libseccomp 受控维护') {
      when {
        expression { params.ACTION == 'UPGRADE_LIBSECCOMP' }
      }
      steps {
        sh '''#!/usr/bin/env bash
set +x
set -Eeuo pipefail
umask 077

SOURCE_DIR="$WORKSPACE/source"
UPGRADER="$SOURCE_DIR/scripts/ops/upgrade-libseccomp-docker18.sh"
PROFILE="$SOURCE_DIR/deploy/seccomp/docker18-clone3.json"
DETECTOR="$SOURCE_DIR/scripts/ci/detect-libseccomp-version.sh"
STATE_DIR="/opt/mateclaw/libseccomp-maintenance"

before_container_id="ABSENT"
before_started_at="ABSENT"
before_image="ABSENT"
before_health="NOT_APPLICABLE"
if docker inspect "$CONTAINER" >/dev/null 2>&1; then
  before_container_id="$(docker inspect --format '{{.Id}}' "$CONTAINER")"
  before_started_at="$(docker inspect --format '{{.State.StartedAt}}' "$CONTAINER")"
  before_image="$(docker inspect --format '{{.Image}}' "$CONTAINER")"
  curl -fsS --max-time 5 "$HEALTH_URL" > libseccomp-before-health.json
  before_health="UP"
fi
before_running_count="$(docker ps -q | wc -l | tr -d ' ')"

"$UPGRADER" --all "$PROFILE" | tee libseccomp-maintenance.txt
grep -Fxq 'LIBSECCOMP_PREPARE_OK' libseccomp-maintenance.txt
grep -Fxq 'LIBSECCOMP_ACTIVATION_OK' libseccomp-maintenance.txt
[[ "$("$DETECTOR")" == '2.5.6' ]]

after_container_id="ABSENT"
after_started_at="ABSENT"
after_image="ABSENT"
after_health="NOT_APPLICABLE"
if [[ "$before_container_id" != "ABSENT" ]]; then
  after_container_id="$(docker inspect --format '{{.Id}}' "$CONTAINER")"
  after_started_at="$(docker inspect --format '{{.State.StartedAt}}' "$CONTAINER")"
  after_image="$(docker inspect --format '{{.Image}}' "$CONTAINER")"
  [[ "$after_container_id" == "$before_container_id" ]]
  [[ "$after_started_at" == "$before_started_at" ]]
  [[ "$after_image" == "$before_image" ]]
  curl -fsS --max-time 5 "$HEALTH_URL" > libseccomp-after-health.json
  after_health="UP"
fi
after_running_count="$(docker ps -q | wc -l | tr -d ' ')"

cp "$STATE_DIR/prepare-report.txt" libseccomp-prepare-report.txt
cp "$STATE_DIR/activation-report.txt" libseccomp-activation-report.txt
{
  echo "before_container_id=$before_container_id"
  echo "after_container_id=$after_container_id"
  echo "before_started_at=$before_started_at"
  echo "after_started_at=$after_started_at"
  echo "before_image=$before_image"
  echo "after_image=$after_image"
  echo "before_health=$before_health"
  echo "after_health=$after_health"
  echo "before_running_count=$before_running_count"
  echo "after_running_count=$after_running_count"
  echo "loaded_libseccomp_version=$("$DETECTOR")"
  echo "existing_mateclaw_restarted=NO"
} > libseccomp-host-continuity.txt
cat libseccomp-host-continuity.txt
echo 'LIBSECCOMP_HOST_MAINTENANCE_OK'
'''
      }
    }

    stage('构建不可变镜像') {
      when {
        expression { params.ACTION != 'UPGRADE_LIBSECCOMP' }
      }
      steps {
        sh '''#!/usr/bin/env bash
set +x
set -euo pipefail

resolved_commit="$(cat resolved-commit.txt)"
SOURCE_DIR="$WORKSPACE/source"
BUILD_SCRIPT="$SOURCE_DIR/scripts/ci/build-test-env-candidate-image.sh"
LEGACY_SECCOMP_PROFILE="$SOURCE_DIR/deploy/seccomp/docker18-clone3.json"
docker_runtime_compatibility="$(
  sed -n 's/^docker_runtime_compatibility=//p' "$WORKSPACE/runtime-compatibility.txt" | head -n 1
)"
runtime_base_image_id="$(
  sed -n 's/^legacy_runtime_probe_image_id=//p' "$WORKSPACE/runtime-compatibility.txt" | head -n 1
)"
runtime_base_image_id="${runtime_base_image_id:-NOT_REQUIRED}"
test -x "$BUILD_SCRIPT" \
  || { echo "IMAGE_BUILD_FAILED: 缺少可执行的候选镜像构建器" >&2; exit 1; }
"$BUILD_SCRIPT" \
  "$docker_runtime_compatibility" \
  "$resolved_commit" \
  "$SOURCE_DIR" \
  "$CANDIDATE_IMAGE" \
  "$LEGACY_SECCOMP_PROFILE" \
  "$runtime_base_image_id" \
  "$WORKSPACE/build-security.txt" \
  "$WORKSPACE/runtime-package-manifest.txt"

docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$CANDIDATE_IMAGE" \
  > candidate-image-env.txt
grep -Fxq "MATECLAW_RELEASE_COMMIT=$resolved_commit" candidate-image-env.txt \
  || {
    echo "IMAGE_BUILD_FAILED: 镜像未固化期望提交" >&2
    exit 1
  }

docker inspect --format '{{.Id}}' "$CANDIDATE_IMAGE" > candidate-image-id.txt
echo "IMAGE_BUILD_OK: $(cat candidate-image-id.txt)"
'''
      }
    }

    stage('镜像与迁移包安全检查') {
      when {
        expression { params.ACTION != 'UPGRADE_LIBSECCOMP' }
      }
      steps {
        sh '''#!/usr/bin/env bash
set +x
set -euo pipefail
umask 077

resolved_commit="$(cat resolved-commit.txt)"
SOURCE_DIR="$WORKSPACE/source"

CANDIDATE_IMAGE_ID="$(cat candidate-image-id.txt)"
[[ "$CANDIDATE_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]] \
  || { echo "MIGRATION_PRECHECK_FAILED: 候选应用镜像 ID 不是完整 SHA-256" >&2; exit 1; }
candidate_tag_image_id="$(docker inspect --format '{{.Id}}' "$CANDIDATE_IMAGE")"
candidate_immutable_image_id="$(docker inspect --format '{{.Id}}' "$CANDIDATE_IMAGE_ID")"
[[ "$candidate_tag_image_id" == "$CANDIDATE_IMAGE_ID" ]] \
  || { echo "MIGRATION_PRECHECK_FAILED: 候选镜像标签在构建后发生漂移" >&2; exit 1; }
[[ "$candidate_immutable_image_id" == "$CANDIDATE_IMAGE_ID" ]] \
  || { echo "MIGRATION_PRECHECK_FAILED: 无法按不可变 ID 确认候选镜像" >&2; exit 1; }

migration_dir="$SOURCE_DIR/mateclaw-server/src/main/resources/db/migration/mysql"
migration_files=()
while IFS= read -r -d '' migration; do
  migration_files+=("$migration")
done < <(find "$migration_dir" -type f -name '*.sql' -print0 | sort -z)
[[ "${#migration_files[@]}" -gt 0 ]] \
  || { echo "MIGRATION_PRECHECK_FAILED: 仓库中没有 MySQL 迁移" >&2; exit 1; }

repo_max_version=0
for migration in "${migration_files[@]}"; do
  filename="${migration##*/}"
  [[ "${migration%/*}" == "$migration_dir" ]] || {
    echo "MIGRATION_PRECHECK_FAILED: 迁移 SQL 位于未审核的子目录：${migration#"$migration_dir"/}" >&2
    exit 1
  }
  case "$filename" in
    V*__*.sql) ;;
    *)
      echo "MIGRATION_PRECHECK_FAILED: 未审核的 repeatable/callback SQL：$filename" >&2
      exit 1
      ;;
  esac
  version="${filename#V}"
  version="${version%%__*}"
  [[ "$version" =~ ^[0-9]+$ ]] \
    || { echo "MIGRATION_PRECHECK_FAILED: 非法迁移文件名 $filename" >&2; exit 1; }
  (( 10#$version > repo_max_version )) && repo_max_version=$((10#$version))
done
printf '%s\n' "$repo_max_version" > repository-max-migration-version.txt

[[ "$APPROVED_FOUNDATION_TO" == "$APPROVED_FORMAL_DIAGNOSIS_FROM" ]] \
  || { echo "MIGRATION_PRECHECK_FAILED: 已审核迁移包不连续" >&2; exit 1; }
[[ "$APPROVED_FORMAL_DIAGNOSIS_TO" == "$APPROVED_ITDB_FROM" ]] \
  || { echo "MIGRATION_PRECHECK_FAILED: ITDB 迁移包与正式排障包不连续" >&2; exit 1; }
[[ "$APPROVED_ITDB_TO" == "$APPROVED_RUNTIME_FROM" ]] \
  || { echo "MIGRATION_PRECHECK_FAILED: 运行态迁移包与 ITDB 迁移包不连续" >&2; exit 1; }
[[ "$repo_max_version" == "$APPROVED_RUNTIME_TO" ]] \
  || { echo "MIGRATION_PRECHECK_FAILED: 仓库迁移终点必须为 V$APPROVED_RUNTIME_TO" >&2; exit 1; }
foundation_migration_sha="$(
  cd "$migration_dir"
  sha256sum V{205..217}__*.sql | sha256sum | awk '{print $1}'
)"
[[ "$foundation_migration_sha" == "$APPROVED_FOUNDATION_SHA256" ]] \
  || { echo "MIGRATION_PRECHECK_FAILED: V205-V217 内容已变化，必须重新审核" >&2; exit 1; }
formal_diagnosis_migration_sha="$(
  cd "$migration_dir"
  sha256sum V{218..223}__*.sql | sha256sum | awk '{print $1}'
)"
[[ "$formal_diagnosis_migration_sha" == "$APPROVED_FORMAL_DIAGNOSIS_SHA256" ]] \
  || { echo "MIGRATION_PRECHECK_FAILED: V218-V223 内容已变化，必须重新审核" >&2; exit 1; }
itdb_migration_sha="$(
  cd "$migration_dir"
  sha256sum V{224..225}__*.sql | sha256sum | awk '{print $1}'
)"
[[ "$itdb_migration_sha" == "$APPROVED_ITDB_SHA256" ]] \
  || { echo "MIGRATION_PRECHECK_FAILED: V224-V225 ITDB 迁移包已变化，必须重新审核" >&2; exit 1; }
runtime_migration_sha="$(
  cd "$migration_dir"
  sha256sum V{226..228}__*.sql | sha256sum | awk '{print $1}'
)"
[[ "$runtime_migration_sha" == "$APPROVED_RUNTIME_SHA256" ]] \
  || { echo "MIGRATION_PRECHECK_FAILED: V226-V228 运行态迁移包已变化，必须重新审核" >&2; exit 1; }

migration_policy="STATIC_APPROVED_V205_TO_V${APPROVED_RUNTIME_TO}_${foundation_migration_sha}_${formal_diagnosis_migration_sha}_${itdb_migration_sha}_${runtime_migration_sha}"
printf '%s\n' "$migration_policy" > migration-policy.txt

{
  echo "resolved_commit=$resolved_commit"
  echo "image_id=$(cat candidate-image-id.txt)"
  echo "repository_max_migration_version=$repo_max_version"
  echo "migration_policy=$migration_policy"
  echo "database_connection=DEFERRED_TO_APPLICATION_STARTUP"
  echo "flyway_execution=APPLICATION_MANAGED"
  echo "runtime_smoke=DEFERRED_TO_MAINTENANCE_CUTOVER"
} > candidate-verification.txt
cat candidate-verification.txt
echo "IMAGE_AND_MIGRATION_PACKAGE_PRECHECK_OK"
'''
      }
    }

    stage('切换与自动回滚') {
      when {
        expression { params.ACTION == 'DEPLOY' }
      }
      steps {
        sh '''#!/usr/bin/env bash
set +x
set -euo pipefail
umask 077

resolved_commit="$(cat resolved-commit.txt)"
TARGET_IMAGE="$(cat target-image.txt)"
SOURCE_DIR="$WORKSPACE/source"
ROLLBACK_CONTAINER="${CONTAINER}-rollback-${BUILD_NUMBER}"
BACKUP_DATA="${RELEASES_DIR}/data-backup-${BUILD_NUMBER}"
FAILED_DATA="${RELEASES_DIR}/data-failed-${BUILD_NUMBER}"
OLD_STOPPED=0
OLD_RENAMED=0
NEW_STARTED=0
BACKUP_CREATED=0
OLD_IMAGE_ID="NONE"
OLD_IMAGE_REF="NONE"

assert_deployed_commit() {
  local info_file="$1"
  local deployed_commit
  deployed_commit="$(
    grep -oE '[0-9a-f]{40}' "$info_file" \
      | head -n 1
  )"
  [[ "$deployed_commit" == "$resolved_commit" ]] || {
    echo "DEPLOY_FAILED: 线上版本号与期望提交不一致" >&2
    cat "$info_file" >&2
    return 1
  }
}

expected_env_file_sha="$(cat env-file-sha256.txt)"
actual_env_file_sha="$(sha256sum "$ENV_FILE" | awk '{print $1}')"
[[ "$actual_env_file_sha" == "$expected_env_file_sha" ]] \
  || { echo "DEPLOY_FAILED: mateclaw.env 在预检后发生变化" >&2; exit 1; }

CANDIDATE_IMAGE_ID="$(cat candidate-image-id.txt)"
[[ "$CANDIDATE_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]] \
  || { echo "DEPLOY_FAILED: 候选应用镜像 ID 不是完整 SHA-256" >&2; exit 1; }
candidate_tag_image_id="$(docker inspect --format '{{.Id}}' "$CANDIDATE_IMAGE")"
candidate_immutable_image_id="$(docker inspect --format '{{.Id}}' "$CANDIDATE_IMAGE_ID")"
[[ "$candidate_tag_image_id" == "$CANDIDATE_IMAGE_ID" ]] \
  || { echo "DEPLOY_FAILED: 候选镜像标签在预检后发生漂移" >&2; exit 1; }
[[ "$candidate_immutable_image_id" == "$CANDIDATE_IMAGE_ID" ]] \
  || { echo "DEPLOY_FAILED: 无法按不可变 ID 确认候选镜像" >&2; exit 1; }

runtime_security_args=()
case "$(sed -n 's/^docker_runtime_compatibility=//p' "$WORKSPACE/runtime-compatibility.txt" | head -n 1)" in
  NATIVE_CLONE3_SECCOMP) ;;
  LEGACY_CUSTOM_SECCOMP)
    LEGACY_SECCOMP_PROFILE="$SOURCE_DIR/deploy/seccomp/docker18-clone3.json"
    expected_seccomp_sha="$(sed -n 's/^legacy_seccomp_profile_sha256=//p' "$WORKSPACE/runtime-compatibility.txt" | head -n 1)"
    actual_seccomp_sha="$(sha256sum "$LEGACY_SECCOMP_PROFILE" | awk '{print $1}')"
    [[ -n "$expected_seccomp_sha" && "$actual_seccomp_sha" == "$expected_seccomp_sha" ]] \
      || { echo "DEPLOY_FAILED: Docker 18 seccomp profile 与预检证据不一致" >&2; exit 1; }
    runtime_security_args=(--security-opt "seccomp=$LEGACY_SECCOMP_PROFILE")
    ;;
  *)
    echo "DEPLOY_FAILED: 缺少有效的 Docker 运行时兼容性结论" >&2
    exit 1
    ;;
esac

rollback() {
  rc=$?
  [[ "$rc" -ne 0 ]] || rc=1
  trap - ERR INT TERM
  set +e
  echo "DEPLOY_FAILED: 开始应用容器回滚；数据库连接与 Flyway 均由应用启动过程管理"

  if [[ "$NEW_STARTED" -eq 1 ]]; then
    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  fi

  if [[ "$BACKUP_CREATED" -eq 1 && -d "$BACKUP_DATA" ]]; then
    if [[ -d "$DATA_DIR" && ! -e "$FAILED_DATA" ]]; then
      mv "$DATA_DIR" "$FAILED_DATA"
    fi
    if [[ ! -e "$DATA_DIR" ]]; then
      mv "$BACKUP_DATA" "$DATA_DIR"
    fi
  fi

  if [[ "$OLD_RENAMED" -eq 1 ]]; then
    docker rename "$ROLLBACK_CONTAINER" "$CONTAINER" >/dev/null 2>&1 || true
    docker start "$CONTAINER" >/dev/null 2>&1 || true
  elif [[ "$OLD_STOPPED" -eq 1 ]]; then
    docker start "$CONTAINER" >/dev/null 2>&1 || true
  fi

  rollback_health="UNAVAILABLE"
  for attempt in $(seq 1 60); do
    if curl -fsS --max-time 3 "$HEALTH_URL" >/dev/null 2>&1; then
      rollback_health="UP"
      break
    fi
    sleep 2
  done
  echo "ROLLBACK_RESULT=$rollback_health"
  exit "$rc"
}
trap rollback ERR INT TERM

[[ ! -e "$BACKUP_DATA" ]] || {
  echo "DEPLOY_FAILED: 备份目录已存在：$BACKUP_DATA" >&2
  exit 1
}
[[ ! -e "$FAILED_DATA" ]] || {
  echo "DEPLOY_FAILED: 失败数据保留目录已存在：$FAILED_DATA" >&2
  exit 1
}

if docker inspect "$CONTAINER" >/dev/null 2>&1; then
  OLD_IMAGE_ID="$(docker inspect --format '{{.Image}}' "$CONTAINER")"
  OLD_IMAGE_REF="$(docker inspect --format '{{.Config.Image}}' "$CONTAINER")"
  docker stop -t 30 "$CONTAINER" >/dev/null
  OLD_STOPPED=1
fi

if [[ -d "$DATA_DIR" ]]; then
  cp -a "$DATA_DIR" "$BACKUP_DATA"
  BACKUP_CREATED=1
fi

if [[ "$OLD_STOPPED" -eq 1 ]]; then
  docker rename "$CONTAINER" "$ROLLBACK_CONTAINER"
  OLD_RENAMED=1
fi

docker tag "$CANDIDATE_IMAGE_ID" "$TARGET_IMAGE"
docker run -d \
  "${runtime_security_args[@]}" \
  --name "$CONTAINER" \
  --restart unless-stopped \
  --env-file "$ENV_FILE" \
  -e 'MATECLAW_FLYWAY_AUTO_REPAIR=false' \
  -e 'JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Shanghai -Dsun.jnu.encoding=UTF-8 -XX:MaxRAMPercentage=45 -XX:+ExitOnOutOfMemoryError' \
  --shm-size 2g \
  --memory 6g \
  --cpus 4 \
  -p 127.0.0.1:18080:18088 \
  -p 127.0.0.1:1455:1455 \
  -v "$DATA_DIR:/app/data" \
  "$TARGET_IMAGE" >/dev/null
NEW_STARTED=1

for attempt in $(seq 1 120); do
  if curl -fsS --max-time 3 "$HEALTH_URL" > deployed-health.json; then
    curl -fsS --max-time 3 "$INFO_URL" > deployed-info.json
    assert_deployed_commit deployed-info.json
    break
  fi
  if ! docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -Fxq true; then
    echo "DEPLOY_FAILED: 新容器提前退出" >&2
    docker logs --tail 160 "$CONTAINER" >&2 || true
    false
  fi
  sleep 3
done

curl -fsS --max-time 5 "$HEALTH_URL" > deployed-health.json
curl -fsS --max-time 5 "$INFO_URL" > deployed-info.json
assert_deployed_commit deployed-info.json
actual_env_file_sha="$(sha256sum "$ENV_FILE" | awk '{print $1}')"
[[ "$actual_env_file_sha" == "$expected_env_file_sha" ]] \
  || { echo "DEPLOY_FAILED: mateclaw.env 在应用启动期间发生变化" >&2; false; }

new_image_id="$(docker inspect --format '{{.Image}}' "$CONTAINER")"
new_state="$(docker inspect --format '{{.State.Status}}' "$CONTAINER")"

if [[ "$OLD_RENAMED" -eq 1 ]]; then
  docker rm "$ROLLBACK_CONTAINER" >/dev/null
fi

trap - ERR INT TERM

{
  echo "deployed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "build_url=$BUILD_URL"
  echo "branch=$BRANCH"
  echo "release_commit=$resolved_commit"
  echo "previous_image_ref=$OLD_IMAGE_REF"
  echo "previous_image_id=$OLD_IMAGE_ID"
  echo "new_image_ref=$TARGET_IMAGE"
  echo "new_image_id=$new_image_id"
  echo "container_state=$new_state"
  echo "health=UP"
  echo "rollback_data=$BACKUP_DATA"
  echo "migration_policy=$(cat migration-policy.txt)"
  echo "database_connection=APPLICATION_MANAGED_FROM_ENV_FILE"
  echo "flyway_execution=APPLICATION_STARTUP"
  echo "env_file_sha256=$expected_env_file_sha"
  echo "listen_address=127.0.0.1:18080"
} > deployment-manifest.txt

cat deployed-health.json
echo
cat deployed-info.json
echo
cat deployment-manifest.txt
echo "DEPLOY_OK"
'''
      }
    }
  }

  post {
    always {
      sh returnStatus: true, script: '''#!/usr/bin/env bash
set +x
set +e
expected_docker_config="$WORKSPACE/.docker-config-${BUILD_NUMBER}"
if [[ "${DOCKER_CONFIG:-}" == "$expected_docker_config" ]]; then
  if [[ -L "$DOCKER_CONFIG" ]]; then
    rm -f -- "$DOCKER_CONFIG"
  elif [[ -d "$DOCKER_CONFIG" ]]; then
    find "$DOCKER_CONFIG" -mindepth 1 -delete
    rmdir -- "$DOCKER_CONFIG" 2>/dev/null || true
  elif [[ -e "$DOCKER_CONFIG" ]]; then
    rm -f -- "$DOCKER_CONFIG"
  fi
fi
if command -v timeout >/dev/null 2>&1; then
  timeout --signal=TERM --kill-after=2s 30 \
    docker image rm "$CANDIDATE_IMAGE" >/dev/null 2>&1 || true
fi
SOURCE_DIR="$WORKSPACE/source"
if [[ "$SOURCE_DIR" == "$WORKSPACE/source" ]]; then
  rm -rf -- "$SOURCE_DIR"
fi
'''
      archiveArtifacts(
        artifacts: 'preflight-report.txt,runtime-compatibility.txt,build-security.txt,runtime-package-manifest.txt,current-health.json,candidate-image-id.txt,candidate-image-env.txt,candidate-verification.txt,repository-max-migration-version.txt,migration-policy.txt,env-file-sha256.txt,deployed-health.json,deployed-info.json,deployment-manifest.txt,resolved-commit.txt,target-image.txt,libseccomp-maintenance.txt,libseccomp-prepare-report.txt,libseccomp-activation-report.txt,libseccomp-host-continuity.txt,libseccomp-before-health.json,libseccomp-after-health.json',
        allowEmptyArchive: true,
        fingerprint: true
      )
    }
    success {
      echo 'MateClaw 测试环境流水线执行成功。'
    }
    failure {
      echo 'MateClaw 流水线失败；若进入切换阶段，日志中会给出自动回滚结果。'
    }
  }
}
