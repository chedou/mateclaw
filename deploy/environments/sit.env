# MateClaw SIT deployment contract.
#
# This file is intentionally committed to GitHub and the internal GitLab. It
# contains only non-secret routing and policy values. The reviewer username and
# password live in the Jenkins username/password credential `mateclaw-itdb-sit`
# and are exposed only as MATECLAW_ITDB_SIT_USR / _PSW during a release.

DEPLOY_ENV=SIT
MATECLAW_ITDB_ENABLED_SIT=true
MATECLAW_ITDB_BASE_URL_SIT=http://itdb.sangfor.com
MATECLAW_ITDB_ALLOWED_HOSTS_SIT=itdb.sangfor.com
MATECLAW_ITDB_ALLOW_INSECURE_HTTP_SIT=true
MATECLAW_ITDB_CREDENTIALS_ID_SIT=mateclaw-itdb-sit
